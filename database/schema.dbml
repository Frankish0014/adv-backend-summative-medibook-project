// Paste into https://dbdiagram.io to re-render the diagram
Table patients {
  id int [pk, increment]
  full_name varchar(100) [not null]
  email varchar(255) [not null, unique]
  phone varchar(20) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}
Table doctors {
  id int [pk, increment]
  full_name varchar(100) [not null]
  specialty varchar(100) [not null]
  consultation_fee decimal(10,2) [not null, note: 'CHECK >= 0']
  room varchar(10) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}
Table appointments {
  id int [pk, increment]
  patient_id int [not null, ref: > patients.id]
  doctor_id int [not null, ref: > doctors.id]
  appt_datetime datetime [not null, note: 'CHECK 09:00-16:30 on :00/:30']
  status enum('booked','cancelled') [not null, default: 'booked']
  amount_paid decimal(10,2) [not null]
  refund_amount decimal(10,2)
  cancelled_at datetime
  booked_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  active_slot datetime [note: "STORED GENERATED: IF(status='booked', appt_datetime, NULL)"]
  indexes {
    (doctor_id, active_slot) [unique, name: 'uq_doctor_active_slot']
  }
}
